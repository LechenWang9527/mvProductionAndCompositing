      "section": "05_liubang_刘邦(古代)"
    },
    {
      "idx": 102,
      "timeStr": "02:51.45",
      "start": 171.45,
      "text": "我只是说没到最后一场",
      "end": 172.97,
      "section": "05_liubang_刘邦(古代)"
    },
    {
      "idx": 103,
      "timeStr": "02:52.97",
      "start": 172.97,
      "text": "别下场",
