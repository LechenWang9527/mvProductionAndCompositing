{"duration": 305.88, "line_count": 167, "lines": [{"section": "00 hook", "text": "我是过来人", "start": 14.99, "end": 16.894, "chars": [{"c": "我", "t": 14.99}, {"c": "是", "t": 15.316}, {"c": "过", "t": 15.642}, {"c": "来", "t": 15.968}, {"c": "人", "t": 16.294}]}, {"section": "00 hook", "text": "一千年前揣着跟你一样的心", "start": 16.62, "end": 20.401, "chars": [{"c": "一", "t": 16.62}, {"c": "千", "t": 16.909}, {"c": "年", "t": 17.198}, {"c": "前", "t": 17.488}, {"c": "揣", "t": 17.777}, {"c": "着", "t": 18.066}, {"c": "跟", "t": 18.355}, {"c": "你", "t": 18.644}, {"c": "一", "t": 18.933}, {"c": "样", "t": 19.223}, {"c": "的", "t": 19.512}, {"c": "心", "t": 19.801}]}, {"section": "00 hook", "text": "你熬的夜 你咽的话", "start": 19.945, "end": 21.997, "chars": [{"c": "你", "t": 19.945}, {"c": "熬", "t": 20.09}, {"c": "的", "t": 20.308}, {"c": "夜", "t": 20.526}, {"c": "你", "t": 20.743}, {"c": "咽", "t": 20.961}, {"c": "的", "t": 21.179}, {"c": "话", "t": 21.397}]}, {"section": "00 hook", "text": "你没赢的仗 我都有份", "start": 21.614, "end": 23.739, "chars": [{"c": "你", "t": 21.614}, {"c": "没", "t": 21.723}, {"c": "赢", "t": 21.832}, {"c": "的", "t": 22.05}, {"c": "仗", "t": 22.268}, {"c": "我", "t": 22.486}, {"c": "都", "t": 22.703}, {"c": "有", "t": 22.921}, {"c": "份", "t": 23.139}]}, {"section": "00 hook", "text": "我不是来教你", "start": 23.357, "end": 25.046, "chars": [{"c": "我", "t": 23.357}, {"c": "不", "t": 23.574}, {"c": "是", "t": 23.792}, {"c": "来", "t": 24.01}, {"c": "教", "t": 24.228}, {"c": "你", "t": 24.446}]}, {"section": "00 hook", "text": "我是来陪你走这一程", "start": 24.663, "end": 27.006, "chars": [{"c": "我", "t": 24.663}, {"c": "是", "t": 24.881}, {"c": "来", "t": 25.099}, {"c": "陪", "t": 25.317}, {"c": "你", "t": 25.534}, {"c": "走", "t": 25.752}, {"c": "这", "t": 25.97}, {"c": "一", "t": 26.188}, {"c": "程", "t": 26.406}]}, {"section": "00 hook", "text": "你不是一个人", "start": 26.623, "end": 28.312, "chars": [{"c": "你", "t": 26.623}, {"c": "不", "t": 26.841}, {"c": "是", "t": 27.059}, {"c": "一", "t": 27.277}, {"c": "个", "t": 27.494}, {"c": "人", "t": 27.712}]}, {"section": "00 hook", "text": "前面有我留的灯", "start": 27.93, "end": 30.458, "chars": [{"c": "前", "t": 27.93}, {"c": "面", "t": 28.316}, {"c": "有", "t": 28.701}, {"c": "我", "t": 29.087}, {"c": "留", "t": 29.472}, {"c": "的", "t": 29.665}, {"c": "灯", "t": 29.858}]}, {"section": "01 dufu", "text": "我是杜甫", "start": 29.993, "end": 31.614, "chars": [{"c": "我", "t": 29.993}, {"c": "是", "t": 30.243}, {"c": "杜", "t": 30.629}, {"c": "甫", "t": 31.014}]}, {"section": "01 dufu", "text": "一辈子都在搬家", "start": 31.4, "end": 33.577, "chars": [{"c": "一", "t": 31.4}, {"c": "辈", "t": 31.663}, {"c": "子", "t": 31.926}, {"c": "都", "t": 32.189}, {"c": "在", "t": 32.451}, {"c": "搬", "t": 32.714}, {"c": "家", "t": 32.977}]}, {"section": "01 dufu", "text": "四十岁还在长安租房", "start": 33.065, "end": 35.356, "chars": [{"c": "四", "t": 33.065}, {"c": "十", "t": 33.152}, {"c": "岁", "t": 33.24}, {"c": "还", "t": 33.493}, {"c": "在", "t": 33.745}, {"c": "长", "t": 33.998}, {"c": "安", "t": 34.251}, {"c": "租", "t": 34.503}, {"c": "房", "t": 34.756}]}, {"section": "01 dufu", "text": "房东一开口就是涨价", "start": 35.009, "end": 37.377, "chars": [{"c": "房", "t": 35.009}, {"c": "东", "t": 35.135}, {"c": "一", "t": 35.261}, {"c": "开", "t": 35.514}, {"c": "口", "t": 35.767}, {"c": "就", "t": 36.019}, {"c": "是", "t": 36.272}, {"c": "涨", "t": 36.525}, {"c": "价", "t": 36.777}]}, {"section": "01 dufu", "text": "后来总算有了茅屋", "start": 36.904, "end": 39.056, "chars": [{"c": "后", "t": 36.904}, {"c": "来", "t": 37.03}, {"c": "总", "t": 37.268}, {"c": "算", "t": 37.505}, {"c": "有", "t": 37.743}, {"c": "了", "t": 37.981}, {"c": "茅", "t": 38.218}, {"c": "屋", "t": 38.456}]}, {"section": "01 dufu", "text": "秋风一来屋子都快散架", "start": 38.694, "end": 41.432, "chars": [{"c": "秋", "t": 38.694}, {"c": "风", "t": 38.931}, {"c": "一", "t": 39.169}, {"c": "来", "t": 39.406}, {"c": "屋", "t": 39.644}, {"c": "子", "t": 39.882}, {"c": "都", "t": 40.119}, {"c": "快", "t": 40.357}, {"c": "散", "t": 40.595}, {"c": "架", "t": 40.832}]}, {"section": "01 dufu", "text": "我写安得广厦千万间", "start": 40.993, "end": 43.372, "chars": [{"c": "我", "t": 40.993}, {"c": "写", "t": 41.153}, {"c": "安", "t": 41.313}, {"c": "得", "t": 41.556}, {"c": "广", "t": 41.799}, {"c": "厦", "t": 42.043}, {"c": "千", "t": 42.286}, {"c": "万", "t": 42.529}, {"c": "间", "t": 42.772}]}, {"section": "01 dufu", "text": "说白了 就是想有个家", "start": 43.015, "end": 45.074, "chars": [{"c": "说", "t": 43.015}, {"c": "白", "t": 43.258}, {"c": "了", "t": 43.502}, {"c": "就", "t": 43.623}, {"c": "是", "t": 43.745}, {"c": "想", "t": 43.988}, {"c": "有", "t": 44.231}, {"c": "个", "t": 44.353}, {"c": "家", "t": 44.474}]}, {"section": "01 dufu", "text": "你也一样吧", "start": 44.596, "end": 46.047, "chars": [{"c": "你", "t": 44.596}, {"c": "也", "t": 44.717}, {"c": "一", "t": 44.961}, {"c": "样", "t": 45.204}, {"c": "吧", "t": 45.447}]}, {"section": "01 dufu", "text": "钥匙串上挂的全是别人的锁", "start": 45.636, "end": 48.679, "chars": [{"c": "钥", "t": 45.636}, {"c": "匙", "t": 45.824}, {"c": "串", "t": 46.013}, {"c": "上", "t": 46.202}, {"c": "挂", "t": 46.458}, {"c": "的", "t": 46.714}, {"c": "全", "t": 46.97}, {"c": "是", "t": 47.226}, {"c": "别", "t": 47.482}, {"c": "人", "t": 47.738}, {"c": "的", "t": 47.909}, {"c": "锁", "t": 48.079}]}, {"section": "01 dufu", "text": "工牌挂在脖子上", "start": 48.25, "end": 50.299, "chars": [{"c": "工", "t": 48.25}, {"c": "牌", "t": 48.491}, {"c": "挂", "t": 48.733}, {"c": "在", "t": 48.974}, {"c": "脖", "t": 49.216}, {"c": "子", "t": 49.457}, {"c": "上", "t": 49.699}]}, {"section": "01 dufu", "text": "一天不摘心就一天不落", "start": 49.819, "end": 52.309, "chars": [{"c": "一", "t": 49.819}, {"c": "天", "t": 49.94}, {"c": "不", "t": 50.161}, {"c": "摘", "t": 50.382}, {"c": "心", "t": 50.603}, {"c": "就", "t": 50.824}, {"c": "一", "t": 51.046}, {"c": "天", "t": 51.267}, {"c": "不", "t": 51.488}, {"c": "落", "t": 51.709}]}, {"section": "01 dufu", "text": "房贷 学费 爸妈的体检单", "start": 51.93, "end": 54.553, "chars": [{"c": "房", "t": 51.93}, {"c": "贷", "t": 52.183}, {"c": "学", "t": 52.436}, {"c": "费", "t": 52.689}, {"c": "爸", "t": 52.815}, {"c": "妈", "t": 52.941}, {"c": "的", "t": 53.194}, {"c": "体", "t": 53.447}, {"c": "检", "t": 53.7}, {"c": "单", "t": 53.953}]}, {"section": "01 dufu", "text": "你一样一样往购物车里搁", "start": 54.016, "end": 56.323, "chars": [{"c": "你", "t": 54.016}, {"c": "一", "t": 54.079}, {"c": "样", "t": 54.142}, {"c": "一", "t": 54.206}, {"c": "样", "t": 54.459}, {"c": "往", "t": 54.711}, {"c": "购", "t": 54.964}, {"c": "物", "t": 55.217}, {"c": "车", "t": 55.47}, {"c": "里", "t": 55.596}, {"c": "搁", "t": 55.723}]}, {"section": "01 dufu", "text": "付完钱一看", "start": 55.976, "end": 57.587, "chars": [{"c": "付", "t": 55.976}, {"c": "完", "t": 56.229}, {"c": "钱", "t": 56.481}, {"c": "一", "t": 56.734}, {"c": "看", "t": 56.987}]}, {"section": "01 dufu", "text": "没一样是给你自己的", "start": 57.24, "end": 59.24, "chars": [{"c": "没", "t": 57.24}, {"c": "一", "t": 57.367}, {"c": "样", "t": 57.495}, {"c": "是", "t": 57.749}, {"c": "给", "t": 58.004}, {"c": "你", "t": 58.258}, {"c": "自", "t": 58.385}, {"c": "己", "t": 58.513}, {"c": "的", "t": 58.64}]}, {"section": "01 dufu", "text": "你也没觉得错", "start": 58.767, "end": 60.385, "chars": [{"c": "你", "t": 58.767}, {"c": "也", "t": 59.022}, {"c": "没", "t": 59.276}, {"c": "觉", "t": 59.531}, {"c": "得", "t": 59.658}, {"c": "错", "t": 59.785}]}, {"section": "02 dufu-son", "text": "我儿子出生那天", "start": 60.053, "end": 62.086, "chars": [{"c": "我", "t": 60.053}, {"c": "儿", "t": 60.303}, {"c": "子", "t": 60.566}, {"c": "出", "t": 60.829}, {"c": "生", "t": 61.091}, {"c": "那", "t": 61.354}, {"c": "天", "t": 61.486}]}, {"section": "02 dufu-son", "text": "我还在长安低头求人办事", "start": 61.617, "end": 64.189, "chars": [{"c": "我", "t": 61.617}, {"c": "还", "t": 61.88}, {"c": "在", "t": 62.143}, {"c": "长", "t": 62.406}, {"c": "安", "t": 62.537}, {"c": "低", "t": 62.669}, {"c": "头", "t": 62.8}, {"c": "求", "t": 62.931}, {"c": "人", "t": 63.194}, {"c": "办", "t": 63.457}, {"c": "事", "t": 63.589}]}, {"section": "02 dufu-son", "text": "你凌晨两点那碗泡面", "start": 63.72, "end": 65.704, "chars": [{"c": "你", "t": 63.72}, {"c": "凌", "t": 63.951}, {"c": "晨", "t": 64.181}, {"c": "两", "t": 64.297}, {"c": "点", "t": 64.412}, {"c": "那", "t": 64.642}, {"c": "碗", "t": 64.758}, {"c": "泡", "t": 64.873}, {"c": "面", "t": 65.104}]}, {"section": "02 dufu-son", "text": "我也吃过 一样的日子", "start": 65.334, "end": 67.779, "chars": [{"c": "我", "t": 65.334}, {"c": "也", "t": 65.565}, {"c": "吃", "t": 65.796}, {"c": "过", "t": 66.026}, {"c": "一", "t": 66.257}, {"c": "样", "t": 66.487}, {"c": "的", "t": 66.718}, {"c": "日", "t": 66.949}, {"c": "子", "t": 67.179}]}, {"section": "02 dufu-son", "text": "我不是来教你的 我就是想说", "start": 67.41, "end": 71.13, "chars": [{"c": "我", "t": 67.41}, {"c": "不", "t": 67.717}, {"c": "是", "t": 68.023}, {"c": "来", "t": 68.33}, {"c": "教", "t": 68.637}, {"c": "你", "t": 68.943}, {"c": "的", "t": 69.097}, {"c": "我", "t": 69.25}, {"c": "就", "t": 69.57}, {"c": "是", "t": 69.89}, {"c": "想", "t": 70.21}, {"c": "说", "t": 70.53}]}, {"section": "02 dufu-son", "text": "这些事儿我也一件一件经历过", "start": 70.85, "end": 74.611, "chars": [{"c": "这", "t": 70.85}, {"c": "些", "t": 71.153}, {"c": "事", "t": 71.457}, {"c": "儿", "t": 71.608}, {"c": "我", "t": 71.76}, {"c": "也", "t": 72.041}, {"c": "一", "t": 72.323}, {"c": "件", "t": 72.604}, {"c": "一", "t": 72.886}, {"c": "件", "t": 73.167}, {"c": "经", "t": 73.449}, {"c": "历", "t": 73.73}, {"c": "过", "t": 74.011}]}, {"section": "03 hook", "text": "我是过来人", "start": 74.293, "end": 76.019, "chars": [{"c": "我", "t": 74.293}, {"c": "是", "t": 74.574}, {"c": "过", "t": 74.856}, {"c": "来", "t": 75.137}, {"c": "人", "t": 75.419}]}, {"section": "03 hook", "text": "一千年前揣着跟你一样的心", "start": 75.7, "end": 79.405, "chars": [{"c": "一", "t": 75.7}, {"c": "千", "t": 76.045}, {"c": "年", "t": 76.39}, {"c": "前", "t": 76.735}, {"c": "揣", "t": 77.08}, {"c": "着", "t": 77.425}, {"c": "跟", "t": 77.77}, {"c": "你", "t": 77.943}, {"c": "一", "t": 78.115}, {"c": "样", "t": 78.288}, {"c": "的", "t": 78.46}, {"c": "心", "t": 78.805}]}, {"section": "03 hook", "text": "你熬的夜你咽的话", "start": 78.92, "end": 80.566, "chars": [{"c