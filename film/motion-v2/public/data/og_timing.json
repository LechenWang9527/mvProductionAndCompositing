 "i", "t": 179.547}, {"c": "t", "t": 179.563}, {"c": "h", "t": 179.58}, {"c": "f", "t": 179.596}, {"c": "u", "t": 179.613}, {"c": "n", "t": 179.629}]}, {"section": "11 ppt", "text": "QM报告里是不是", "start": 179.645, "end": 180.723, "chars": [{"c": "Q", "t": 179.645}, {"c": "M", "t": 179.662}, {"c": "报", "t": 179.678}, {"c": "告", "t": 179.695}, {"c": "里", "t": 179.711}, {"c": "是", "t": 179.728}, {"c": "不", "t": 180.04}, {"c": "是", "t": 180.123}]}, {"section": "11 ppt", "text": "我的Code永远也跑不掉", "start": 180.205, "end": 182.379, "chars": [{"c": "我", "t": 180.205}, {"c": "的", "t": 180.288}, {"c": "C", "t": 180.387}, {"c": "o", "t": 180.487}, {"c": "d", "t": 180.586}, {"c": "e", "t": 180.685}, {"c": "永", "t": 180.784}, {"c": "远", "t": 181.032}, {"c": "也", "t": 181.156}, {"c": "跑", "t": 181.28}, {"c": "不", "t": 181.529}, {"c": "掉", "t": 181.779}]}, {"section": "12 no-complaint", "text": "我没怼过谁", "start": 181.775, "end": 183.369, "chars": [{"c": "我", "t": 181.775}, {"c": "没", "t": 182.025}, {"c": "怼", "t": 182.273}, {"c": "过", "t": 182.521}, {"c": "谁", "t": 182.769}]}, {"section": "12 no-complaint", "text": "我只是没让他们看见我无奈", "start": 183.017, "end": 185.602, "chars": [{"c": "我", "t": 183.017}, {"c": "只", "t": 183.141}, {"c": "是", "t": 183.265}, {"c": "没", "t": 183.389}, {"c": "让", "t": 183.513}, {"c": "他", "t": 183.761}, {"c": "们", "t": 183.885}, {"c": "看", "t": 184.01}, {"c": "见", "t": 184.258}, {"c": "我", "t": 184.506}, {"c": "无", "t": 184.754}, {"c": "奈", "t": 185.002}]}, {"section": "12 no-complaint", "text": "没有报表 我就自己导", "start": 185.126, "end": 187.567, "chars": [{"c": "没", "t": 185.126}, {"c": "有", "t": 185.25}, {"c": "报", "t": 185.495}, {"c": "表", "t": 185.741}, {"c": "我", "t": 185.986}, {"c": "就", "t": 186.231}, {"c": "自", "t": 186.477}, {"c": "己", "t": 186.722}, {"c": "导", "t": 186.967}]}, {"section": "12 no-complaint", "text": "也无白天也无夜", "start": 187.213, "end": 189.285, "chars": [{"c": "也", "t": 187.213}, {"c": "无", "t": 187.458}, {"c": "白", "t": 187.703}, {"c": "天",